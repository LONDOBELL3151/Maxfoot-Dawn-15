{% comment %}MAXFOOT Blog Display Section{% endcomment %}

{%- style -%}
  .blog-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #FFFFFF;
  }

  .blog-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 48px;
  }

  .blog-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1A1C1C;
    margin: 0;
  }

  .blog-view-all {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    text-decoration: none;
    border-bottom: 2px solid #FFC426;
    padding-bottom: 4px;
    transition: opacity 0.2s ease;
  }

  .blog-view-all:hover {
    opacity: 0.8;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .blog-card {
    transition: transform 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
  }

  .blog-card-media {
    position: relative;
    aspect-ratio: 16/10;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 24px;
    background-color: #F5F5F5;
  }

  .blog-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-card-media img {
    transform: scale(1.05);
  }

  .blog-card-label {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
  }

  .blog-card-meta {
    margin-bottom: 12px;
  }

  .blog-card-date {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #9ca3af;
  }

  .blog-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #1A1C1C;
    margin: 0 0 12px 0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .blog-card:hover .blog-card-title {
    color: #FFC426;
  }

  .blog-card-excerpt {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #6B7280;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    text-decoration: none;
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .blog-card:hover .blog-card-link {
    transform: translateX(4px);
  }

  /* Responsive */
  @media screen and (max-width: 989px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .blog-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .blog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .blog-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .blog-container {
      padding: 0 24px;
    }
  }
{%- endstyle -%}

<section class="blog-section">
  <div class="blog-container">
    <div class="blog-header">
      <h2 class="blog-title">{{ section.settings.title | default: 'Latest Stories' }}</h2>
      <a href="{{ section.settings.view_all_link }}" class="blog-view-all">
        {{ section.settings.view_all_text | default: 'ALL STORIES' }}
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="blog-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'post' -%}
            <a href="{{ block.settings.article.url }}" class="blog-card" {{ block.shopify_attributes }}>
              <div class="blog-card-media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
                {%- elsif block.settings.article != blank -%}
                  <img src="{{ block.settings.article.image | image_url: width: 600 }}" alt="{{ block.settings.article.title | escape }}" loading="lazy">
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="blog-card-label">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
              <div class="blog-card-meta">
                <span class="blog-card-date">{{ block.settings.date | default: 'MARCH 15, 2024' }}</span>
              </div>
              <h3 class="blog-card-title">{{ block.settings.title | default: block.settings.article.title }}</h3>
              <p class="blog-card-excerpt">{{ block.settings.excerpt }}</p>
              <span class="blog-card-link">READ MORE →</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="blog-grid">
        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div style="width:100%;height:100%;background:#F5F5F5;display:flex;align-items:center;justify-content:center;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">ADVENTURE</span>
          </div>
          <div class="blog-card-meta">
            <span class="blog-card-date">MARCH 15, 2024</span>
          </div>
          <h3 class="blog-card-title">Conquering the High Sierras with the M-3</h3>
          <p class="blog-card-excerpt">Discover how our latest fat-tire model handled the rugged terrain and elevation changes of the Sierra Nevada trails.</p>
          <span class="blog-card-link">READ MORE →</span>
        </a>

        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div style="width:100%;height:100%;background:#F5F5F5;display:flex;align-items:center;justify-content:center;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">TECH</span>
          </div>
          <div class="blog-card-meta">
            <span class="blog-card-date">FEBRUARY 28, 2024</span>
          </div>
          <h3 class="blog-card-title">The Science of High-Torque Hub Motors</h3>
          <p class="blog-card-excerpt">A deep dive into the engineering behind our 750W brushless motor and how it delivers consistent power.</p>
          <span class="blog-card-link">READ MORE →</span>
        </a>

        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div style="width:100%;height:100%;background:#F5F5F5;display:flex;align-items:center;justify-content:center;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">LIFESTYLE</span>
          </div>
          <div class="blog-card-meta">
            <span class="blog-card-date">JANUARY 12, 2024</span>
          </div>
          <h3 class="blog-card-title">Urban Mobility: The Future is Electric</h3>
          <p class="blog-card-excerpt">How electric bikes are reshaping city transportation and reducing the carbon footprint of daily commutes.</p>
          <span class="blog-card-link">READ MORE →</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Display",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Latest Stories"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "ALL STORIES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Blog Post",
      "settings": [
        { "type": "article", "id": "article", "label": "Select Article" },
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "label", "label": "Category Label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Display",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}