{% comment %}MAXFOOT Hero Banner Section{% endcomment %}

{%- style -%}
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 870px;
    background-color: #FFFFFF;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .hero-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-placeholder-bg {
    width: 100%;
    height: 100%;
    background-color: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-placeholder-bg span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #9ca3af;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.2) 100%);
    z-index: 2;
  }

  .hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 870px;
    max-width: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: stretch;
  }

  .hero-content {
    width: 50%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 64px;
    background-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
  }

  .hero-badge {
    display: inline-block;
    background-color: #FFC426;
    color: #785a00;
    padding: 6px 16px;
    margin-bottom: 24px;
    border-radius: 4px;
    width: fit-content;
  }

  .hero-badge span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1A1C1C;
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: #FFC426;
  }

  .hero-description {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #4f4633;
    margin-bottom: 40px;
    max-width: 480px;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .hero-btn-primary:hover {
    opacity: 0.9;
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 32px;
    border: 2px solid #1A1C1C;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero-btn-secondary:hover {
    background-color: #1A1C1C;
    color: #FFFFFF;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 989px) {
    .hero-section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .hero-media {
      position: relative;
      height: 50vh;
      order: 1;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.8) 100%);
      height: 100%;
      bottom: 0;
      top: auto;
      order: 2;
    }

    .hero-container {
      position: relative;
      height: auto;
      flex-direction: column;
      order: 3;
    }

    .hero-content {
      width: 100%;
      height: auto;
      padding: 32px 24px;
      background-color: rgba(255, 255, 255, 0.95);
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      text-align: center;
      padding: 14px 24px;
    }
  }
{%- endstyle -%}

<section class="hero-section">
  <div class="hero-media">
    {%- if section.settings.image_pc != blank -%}
      <img
        src="{{ section.settings.image_pc | image_url: width: 1920 }}"
        alt="{{ section.settings.image_pc.alt | escape }}"
        class="hero-image"
        loading="eager"
      >
    {%- else -%}
      <div class="hero-placeholder-bg">
        <span>UPLOAD HERO IMAGE</span>
      </div>
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>NEW GENERATION E-BIKE</span>
      </div>
      <h1 class="hero-title">
        Unleash the <span class="highlight">RAW</span> Power
      </h1>
      <p class="hero-description">
        Meet the M-3, a high-torque beast engineered for those who demand uncompromising performance on every terrain. Experience the pinnacle of electric propulsion.
      </p>
      <div class="hero-buttons">
        {%- if section.settings.button_primary_text != blank -%}
          <a href="{{ section.settings.button_primary_link }}" class="hero-btn-primary">
            {{ section.settings.button_primary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-primary">PRE-ORDER NOW</a>
        {%- endif -%}
        {%- if section.settings.button_secondary_text != blank -%}
          <a href="{{ section.settings.button_secondary_link }}" class="hero-btn-secondary">
            {{ section.settings.button_secondary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-secondary">TECHNICAL SPECS</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Hero Image (PC)",
      "info": "Recommended size: 1920x870px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Recommended size: 800x600px"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Primary Button Text",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary Button Text",
      "default": "TECHNICAL SPECS"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}