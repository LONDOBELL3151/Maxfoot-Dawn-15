            <span class="product-card-label">HOT</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="product-card-content">
            <h3 class="product-card-title">MAXFOOT OFF-ROAD</h3>
            <p class="product-card-price">$2,199.00</p>
          </div>
        </div>
        <div class="product-card">
          <div class="product-card-media">
            <span class="product-card-label">HOT</span>
