{% comment %}MAXFOOT Feature Bento Grid{% endcomment %}

{%- style -%}
  .bento-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #FFFFFF;
  }

  .bento-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 400px 400px;
    gap: 24px;
  }

  .bento-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .bento-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .bento-card:hover .bento-card-image {
    transform: scale(1.05);
  }

  .bento-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 100%);
    transition: background 0.3s ease;
  }

  .bento-card:hover .bento-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 100%);
  }

  .bento-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px;
    z-index: 2;
  }

  .bento-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 16px;
  }

  .bento-card-button {
    display: inline-block;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .bento-card-button:hover {
    opacity: 0.9;
  }

  /* Large card - Conquer Any Peak */
  .bento-card--large {
    grid-column: span 8;
    grid-row: span 1;
    background-color: #2F3131;
  }

  .bento-card--large .bento-card-content {
    background-color: rgba(255,255,255,0.85);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 16px 24px;
    margin: 0 32px 32px 32px;
    width: auto;
    bottom: 32px;
    left: 0;
    right: auto;
    display: inline-block;
  }

  .bento-card--large .bento-card-title {
    color: #1A1C1C;
    font-size: 24px;
    margin: 0;
  }

  .bento-card--large .bento-card-button {
    display: none;
  }

  /* Medium card - Built for the Bold */
  .bento-card--medium {
    grid-column: span 4;
    grid-row: span 1;
    background-color: #FFC426;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px;
  }

  .bento-card--medium .bento-card-title {
    color: #785a00;
    font-size: 32px;
    margin-bottom: 24px;
  }

  .bento-card--medium p {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    color: #785a00;
    opacity: 0.8;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .bento-card--medium .bento-divider {
    width: 64px;
    height: 4px;
    background-color: #785a00;
    margin-bottom: 32px;
  }

  .bento-card--medium .bento-card-button {
    background-color: #785a00;
    color: #FFFFFF;
  }

  /* Small card - Precision */
  .bento-card--small {
    grid-column: span 4;
    grid-row: span 1;
    background-color: #FFC426;
    position: relative;
  }

  .bento-card--small .bento-card-overlay {
    display: none;
  }

  .bento-card--small .bento-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bento-card--small .bento-card-content {
    position: relative;
    z-index: 2;
    padding: 16px 20px;
    background-color: #1A1C1C;
    margin: 16px;
    border-radius: 10px;
    width: auto;
    display: inline-block;
  }

  .bento-card--small .bento-card-tag {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    margin: 0 0 6px 0;
  }

  .bento-card--small .bento-card-title {
    color: #FFFFFF;
    font-size: 18px;
    margin: 0;
  }

  /* Wide card - Seamless City */
  .bento-card--wide {
    grid-column: span 8;
    grid-row: span 1;
    background-color: #E5E5E5;
  }

  .bento-card--wide .bento-card-overlay {
    display: none;
  }

  .bento-card--wide .bento-card-content {
    position: relative;
    bottom: auto;
    padding: 20px;
    background-color: #1A1C1C;
    margin: 16px;
    border-radius: 10px;
    width: auto;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bento-card--wide .bento-card-title {
    color: #FFFFFF;
    font-size: 18px;
    margin: 0;
  }

  /* Responsive */
  @media screen and (max-width: 989px) {
    .bento-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(3, 300px);
    }

    .bento-card--large {
      grid-column: span 6;
    }

    .bento-card--medium {
      grid-column: span 6;
    }

    .bento-card--small {
      grid-column: span 3;
    }

    .bento-card--wide {
      grid-column: span 6;
    }

    .bento-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 16px;
    }

    .bento-card--large,
    .bento-card--medium,
    .bento-card--small,
    .bento-card--wide {
      grid-column: span 1;
      grid-row: span 1;
      min-height: 300px;
    }

    .bento-card--large .bento-card-content {
      margin: 20px;
      padding: 16px 20px;
      width: auto;
      display: block;
      bottom: auto;
      left: auto;
    }

    .bento-card--small {
      display: block;
      position: relative;
    }

    .bento-card--small .bento-card-content {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 2;
      margin: 0;
      padding: 16px 20px;
      background-color: #1A1C1C;
      border-radius: 10px;
      width: max-content;
    }

    .bento-card--wide {
      display: block;
      position: relative;
    }

    .bento-card--wide .bento-card-content {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 2;
      margin: 0;
      padding: 16px 20px;
      background-color: #1A1C1C;
      border-radius: 10px;
      width: max-content;
    }

    .bento-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .bento-container {
      padding: 0 24px;
    }

    .bento-card-content {
      padding: 24px;
    }

    .bento-card--medium {
      padding: 32px;
    }
  }
{%- endstyle -%}

<section class="bento-section">
  <div class="bento-container">
    <div class="bento-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'conquer_peak' -%}
            <div class="bento-card bento-card--large" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" class="bento-card-image" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:#2F3131;display:flex;align-items:center;justify-content:center;">
                  <span style="font-family:'Space Grotesk';color:#FFC426;font-size:14px;letter-spacing:0.2em;">CONQUER ANY PEAK</span>
                </div>
              {%- endif -%}
              <div class="bento-card-overlay"></div>
              <div class="bento-card-content">
                <h2 class="bento-card-title">{{ block.settings.title | default: 'Conquer Any Peak' }}</h2>
              </div>
            </div>

          {%- when 'built_bold' -%}
            <div class="bento-card bento-card--medium" {{ block.shopify_attributes }}>
              <h2 class="bento-card-title">{{ block.settings.title | default: 'Built for the Bold.' }}</h2>
              <p>{{ block.settings.description | default: "Every Maxfoot is a statement of freedom and engineering excellence. We don't just build bikes; we build adventure machines." }}</p>
              <div class="bento-divider"></div>
              <a href="{{ block.settings.button_link }}" class="bento-card-button">{{ block.settings.button_text | default: 'LEARN MORE' }}</a>
            </div>

          {%- when 'precision' -%}
            <div class="bento-card bento-card--small" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.image.alt | escape }}" class="bento-card-image" loading="lazy">
              {%- endif -%}
              <div class="bento-card-content">
                {%- if block.settings.tag != blank -%}
                  <span class="bento-card-tag">{{ block.settings.tag }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="bento-card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
              </div>
            </div>

          {%- when 'seamless_city' -%}
            <div class="bento-card bento-card--wide" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" class="bento-card-image" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:#E5E5E5;display:flex;align-items:center;justify-content:center;">
                  <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.2em;">SEAMLESS CITY FLOW</span>
                </div>
              {%- endif -%}
              <div class="bento-card-overlay"></div>
              <div class="bento-card-content">
                <h3 class="bento-card-title">{{ block.settings.title | default: 'Seamless City Flow' }}</h3>
              </div>
            </div>
        {%- endcase -%}
      {%- else -%}
        <div class="bento-card bento-card--large">
          <div style="width:100%;height:100%;background:#2F3131;display:flex;align-items:flex-end;justify-content:flex-start;">
            <div class="bento-card-content">
              <h2 class="bento-card-title">Conquer Any Peak</h2>
            </div>
          </div>
        </div>

        <div class="bento-card bento-card--medium">
          <h2 class="bento-card-title">Built for the Bold.</h2>
          <p>Every Maxfoot is a statement of freedom and engineering excellence. We don't just build bikes; we build adventure machines.</p>
          <div class="bento-divider"></div>
          <a href="#" class="bento-card-button">LEARN MORE</a>
        </div>

        <div class="bento-card bento-card--small">
          <div class="bento-card-content">
            <span class="bento-card-tag">PRECISION</span>
            <h3 class="bento-card-title">Precision</h3>
          </div>
        </div>

        <div class="bento-card bento-card--wide">
          <div style="width:100%;height:100%;background:#E5E5E5;display:flex;align-items:center;justify-content:center;">
            <div class="bento-card-content">
              <h3 class="bento-card-title">Seamless City Flow</h3>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "MULTI-DIMENSIONAL PERFORMANCE"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "conquer_peak",
      "name": "Conquer Any Peak",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Conquer Any Peak" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "EXPLORE ADVENTURE" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    },
    {
      "type": "built_bold",
      "name": "Built for the Bold",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Built for the Bold." },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "LEARN MORE" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    },
    {
      "type": "precision",
      "name": "Precision",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "PRECISION" },
        { "type": "text", "id": "title", "label": "Title", "default": "Precision" }
      ]
    },
    {
      "type": "seamless_city",
      "name": "Seamless City Flow",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Seamless City Flow" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Grid",
      "blocks": [
        { "type": "conquer_peak" },
        { "type": "built_bold" },
        { "type": "precision" },
        { "type": "seamless_city" }
      ]
    }
  ]
}
{% endschema %}