{% comment %}MAXFOOT Multi-dimensional Bento Grid Section{% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .bento-section {
    padding: 80px 0;
    background-color: #F9F9F9;
  }

  .bento-header {
    text-align: center;
    margin-bottom: 4rem;
    padding: 0 3.2rem;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
  }

  .bento-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1A1C1C;
    margin: 0 0 1rem 0;
  }

  .bento-subtitle {
    font-family: 'Lexend', sans-serif;
    font-size: 1rem;
    color: #6b7280;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .bento-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 3.2rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 24px;
  }

  .bento-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
    transition: all 0.4s ease;
  }

  .bento-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(0,0,0,0.12);
  }

  .bento-card-media {
    position: relative;
    overflow: hidden;
  }

  .bento-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .bento-card:hover .bento-card-media img {
    transform: scale(1.08);
  }

  .bento-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(26,28,28,0) 30%, rgba(26,28,28,0.7) 100%);
  }

  .bento-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    z-index: 2;
  }

  .bento-card-tag {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFC426;
    background: rgba(26,28,28,0.6);
    padding: 0.375rem 0.75rem;
    border-radius: 20px;
    margin-bottom: 0.75rem;
    backdrop-filter: blur(4px);
  }

  .bento-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .bento-card-description {
    font-family: 'Lexend', sans-serif;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
    margin: 0 0 1.25rem 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bento-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .bento-card-button:hover {
    color: #FFFFFF;
    gap: 0.75rem;
  }

  .bento-card-button svg {
    transition: transform 0.3s ease;
  }

  .bento-card-button:hover svg {
    transform: translateX(4px);
  }

  /* Grid layout variations */
  .bento-card--large {
    grid-column: span 7;
    grid-row: span 1;
    min-height: 480px;
  }

  .bento-card--large .bento-card-media {
    height: 100%;
    min-height: 480px;
  }

  .bento-card--medium {
    grid-column: span 5;
    grid-row: span 1;
    min-height: 480px;
  }

  .bento-card--medium .bento-card-media {
    height: 100%;
    min-height: 480px;
  }

  .bento-card--small {
    grid-column: span 4;
    grid-row: span 1;
    min-height: 360px;
  }

  .bento-card--small .bento-card-media {
    height: 100%;
    min-height: 360px;
  }

  .bento-card--small .bento-card-title {
    font-size: 1.25rem;
  }

  .bento-card--small .bento-card-description {
    -webkit-line-clamp: 2;
  }

  /* Mobile responsive */
  @media screen and (max-width: 989px) {
    .bento-card--large,
    .bento-card--medium {
      grid-column: span 6;
      min-height: 360px;
    }

    .bento-card--large .bento-card-media,
    .bento-card--medium .bento-card-media {
      min-height: 360px;
    }

    .bento-card--small {
      grid-column: span 6;
    }
  }

  @media screen and (max-width: 749px) {
    .bento-section {
      padding: 60px 0;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .bento-card--large,
    .bento-card--medium,
    .bento-card--small {
      grid-column: span 1;
      min-height: 320px;
    }

    .bento-card--large .bento-card-media,
    .bento-card--medium .bento-card-media,
    .bento-card--small .bento-card-media {
      min-height: 320px;
    }

    .bento-card-content {
      padding: 1.5rem;
    }

    .bento-card-title {
      font-size: 1.25rem;
    }

    .bento-card-description {
      display: none;
    }
  }
{%- endstyle -%}

<section class="bento-section">
  <div class="bento-header">
    {%- if section.settings.title != blank -%}
      <h2 class="bento-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="bento-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="bento-container">
    {%- if section.blocks.size > 0 -%}
      <div class="bento-grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'conquer_peak' -%}
              <div class="bento-card bento-card--large" {{ block.shopify_attributes }}>
                <div class="bento-card-media">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 900 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="900"
                      height="600"
                    >
                  {%- else -%}
                    <div class="placeholder-bg" style="background-color: #2d2d2d; height: 100%; min-height: 480px; display: flex; align-items: center; justify-content: center;">
                      <span style="color: #FFC426; font-family: 'Space Grotesk', sans-serif; font-size: 0.875rem; letter-spacing: 0.2em;">CONQUER ANY PEAK</span>
                    </div>
                  {%- endif -%}
                  <div class="bento-card-overlay"></div>
                </div>
                <div class="bento-card-content">
                  <span class="bento-card-tag">POWER</span>
                  <h3 class="bento-card-title">{{ block.settings.title | default: 'Conquer Any Peak' }}</h3>
                  <p class="bento-card-description">{{ block.settings.description | default: '750W motor power with full suspension system. Take on any terrain with confidence and control.' }}</p>
                  <a href="{{ block.settings.button_link }}" class="bento-card-button">
                    {{ block.settings.button_text | default: 'LEARN MORE' }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
