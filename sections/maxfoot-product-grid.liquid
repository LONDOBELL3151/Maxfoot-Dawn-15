{% comment %}MAXFOOT Product Grid Section{% endcomment %}

{%- style -%}
  .product-grid-section {
    padding: 120px 0;
    background-color: #FFFFFF;
  }

  .product-grid-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .product-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .product-grid-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1A1C1C;
    margin: 0;
    text-transform: uppercase;
  }

  .product-grid-view-all {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    text-decoration: none;
    border-bottom: 2px solid #FFC426;
    padding-bottom: 4px;
    transition: opacity 0.2s ease;
  }

  .product-grid-view-all:hover {
    opacity: 0.8;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* Product Card */
  .product-card {
    background: #FAFAFA;
    border: 1px solid #E5E5E5;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-card:hover {
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }

  .product-card-media {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #F5F5F5;
    overflow: hidden;
  }

  .product-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 32px;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card-media img {
    transform: scale(1.1);
  }

  .product-card-label {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: #FFC426;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    z-index: 1;
  }

  .product-card-content {
    padding: 24px;
    text-align: center;
  }

  .product-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #1A1C1C;
    margin: 0 0 8px 0;
  }

  .product-card-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFC426;
  }

  /* Responsive */
  @media screen and (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .product-grid-section {
      padding: 80px 0;
    }
  }

  @media screen and (max-width: 749px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .product-grid-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .product-grid-section {
      padding: 60px 0;
    }

    .product-grid-container {
      padding: 0 24px;
    }

    .product-card-content {
      padding: 20px;
    }
  }
{%- endstyle -%}

<section class="product-grid-section">
  <div class="product-grid-container">
    <div class="product-grid-header">
      <h2 class="product-grid-title">{{ section.settings.title | default: 'HOT SELLING' }}</h2>
      <a href="{{ section.settings.view_all_link }}" class="product-grid-view-all">
        {{ section.settings.view_all_text | default: 'VIEW ALL PRODUCTS' }}
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="product-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- assign product = all_products[block.settings.product] -%}
            {%- if product != blank -%}
              <div class="product-card" {{ block.shopify_attributes }}>
                <div class="product-card-media">
                  {%- if block.settings.label != blank -%}
                    <span class="product-card-label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
                  {%- else -%}
                    <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="product-card-content">
                  <h3 class="product-card-title">{{ block.settings.title | default: product.title }}</h3>
                  <p class="product-card-price">{{ product.price | money }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid">
        <div class="product-card">
          <div class="product-card-media">
            <span class="product-card-label">HOT</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
