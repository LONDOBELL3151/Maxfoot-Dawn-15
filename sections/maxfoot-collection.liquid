{% comment %}MAXFOOT Collection Page Section{% endcomment %}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}

<section class="collection-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="collection-container">
    <header class="collection-header">
      <h2 class="collection-title">{{ section.settings.title | default: 'ENGINEERED SERIES' }}</h2>
      <div class="collection-description">
        <p>{{ section.settings.description | default: 'Pushing the boundaries of electric mobility. Our Engineered Series combines high-performance power units with aerospace-grade materials for the ultimate riding experience.' }}</p>
      </div>
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="collection-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- assign product = all_products[block.settings.product] -%}
            <div class="collection-card" {{ block.shopify_attributes }}>
              <div class="collection-card-media">
                {%- if block.settings.label != blank -%}
                  <span class="collection-card-label {% if block.settings.label_style == 'black' %}black{% else %}gold{% endif %}">{{ block.settings.label }}</span>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
                {%- else -%}
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="collection-card-content">
                <div class="collection-card-meta">
                  <h3 class="collection-card-title">{{ block.settings.title | default: product.title }}</h3>
                  {%- if block.settings.subtitle != blank -%}
                    <p class="collection-card-subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                </div>
                <div class="collection-card-pricing">
                  <div class="collection-price-wrap">
                    <span class="collection-card-price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="collection-card-compare-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  <div class="collection-review-wrap">
                    <svg class="collection-review-star" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                    <span class="collection-review-score">{{ block.settings.review_score | default: '4.9' }}</span>
                  </div>
                </div>
                {%- if block.settings.spec1_label != blank or block.settings.spec2_label != blank or block.settings.spec3_label != blank -%}
                <div class="collection-card-specs">
                  {%- if block.settings.spec1_label != blank -%}
                  <div class="collection-spec-item">
                    <span class="collection-spec-label">{{ block.settings.spec1_label }}</span>
                    <span class="collection-spec-value {% if block.settings.spec1_style == 'gold' %}gold{% endif %}">{{ block.settings.spec1_value }}</span>
                  </div>
                  {%- endif -%}
                  {%- if block.settings.spec2_label != blank -%}
                  <div class="collection-spec-item">
                    <span class="collection-spec-label">{{ block.settings.spec2_label }}</span>
                    <span class="collection-spec-value {% if block.settings.spec2_style == 'gold' %}gold{% endif %}">{{ block.settings.spec2_value }}</span>
                  </div>
                  {%- endif -%}
                  {%- if block.settings.spec3_label != blank -%}
                  <div class="collection-spec-item">
                    <span class="collection-spec-label">{{ block.settings.spec3_label }}</span>
                    <span class="collection-spec-value {% if block.settings.spec3_style == 'gold' %}gold{% endif %}">{{ block.settings.spec3_value }}</span>
                  </div>
                  {%- endif -%}
                </div>
                {%- endif -%}
                {%- if block.settings.button_text != blank -%}
                  <a href="{{ product.url }}" class="collection-card-btn">{{ block.settings.button_text }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="collection-grid">
        <div class="collection-card">
          <div class="collection-card-media">
            <span class="collection-card-label gold">PRO SPEC</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f3f4;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="collection-card-content">
            <div class="collection-card-meta">
              <h3 class="collection-card-title">Trail Master</h3>
              <p class="collection-card-subtitle">Unrivaled off-road performance for explorers.</p>
            </div>
            <div class="collection-card-pricing">
              <div class="collection-price-wrap">
                <span class="collection-card-price">$2,499.00</span>
              </div>
              <div class="collection-review-wrap">
                <svg class="collection-review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="collection-review-score">4.9</span>
              </div>
            </div>
            <div class="collection-card-specs">
              <div class="collection-spec-item">
                <span class="collection-spec-label">Range</span>
                <span class="collection-spec-value">60mi</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Power</span>
                <span class="collection-spec-value gold">1200w</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Speed</span>
                <span class="collection-spec-value">28mph</span>
              </div>
            </div>
            <a href="#" class="collection-card-btn">Add to Cart</a>
          </div>
        </div>
        <div class="collection-card">
          <div class="collection-card-media">
            <span class="collection-card-label gold">URBAN CORE</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f3f4;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="collection-card-content">
            <div class="collection-card-meta">
              <h3 class="collection-card-title">City Phantom</h3>
              <p class="collection-card-subtitle">Silent, stealthy, and incredibly agile.</p>
            </div>
            <div class="collection-card-pricing">
              <div class="collection-price-wrap">
                <span class="collection-card-price">$1,899.00</span>
              </div>
              <div class="collection-review-wrap">
                <svg class="collection-review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="collection-review-score">4.8</span>
              </div>
            </div>
            <div class="collection-card-specs">
              <div class="collection-spec-item">
                <span class="collection-spec-label">Speed</span>
                <span class="collection-spec-value">28mph</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Weight</span>
                <span class="collection-spec-value gold">48lbs</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Battery</span>
                <span class="collection-spec-value">48V</span>
              </div>
            </div>
            <a href="#" class="collection-card-btn">Add to Cart</a>
          </div>
        </div>
        <div class="collection-card">
          <div class="collection-card-media">
            <span class="collection-card-label black">HEAVY DUTY</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f3f4;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="collection-card-content">
            <div class="collection-card-meta">
              <h3 class="collection-card-title">Cargo X-Treme</h3>
              <p class="collection-card-subtitle">Maximum utility meets extreme power.</p>
            </div>
            <div class="collection-card-pricing">
              <div class="collection-price-wrap">
                <span class="collection-card-price">$2,799.00</span>
              </div>
              <div class="collection-review-wrap">
                <svg class="collection-review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="collection-review-score">4.7</span>
              </div>
            </div>
            <div class="collection-card-specs">
              <div class="collection-spec-item">
                <span class="collection-spec-label">Payload</span>
                <span class="collection-spec-value">400lbs</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Battery</span>
                <span class="collection-spec-value gold">Dual</span>
              </div>
              <div class="collection-spec-item">
                <span class="collection-spec-label">Motor</span>
                <span class="collection-spec-value">750w</span>
              </div>
            </div>
            <a href="#" class="collection-card-btn">Add to Cart</a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "ENGINEERED SERIES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Pushing the boundaries of electric mobility. Our Engineered Series combines high-performance power units with aerospace-grade materials for the ultimate riding experience."
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Product Label",
          "info": "e.g., PRO SPEC, URBAN CORE"
        },
        {
          "type": "select",
          "id": "label_style",
          "label": "Label Background",
          "options": [
            { "value": "gold", "label": "Gold (#FFC426)" },
            { "value": "black", "label": "Black (#1A1C1C)" }
          ],
          "default": "gold"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "review_score",
          "label": "Review Score",
          "default": "4.9"
        },
        {
          "type": "header",
          "content": "Specs (3 columns)"
        },
        {
          "type": "text",
          "id": "spec1_label",
          "label": "Spec 1 Label",
          "info": "e.g., Range, Speed, Power"
        },
        {
          "type": "text",
          "id": "spec1_value",
          "label": "Spec 1 Value",
          "info": "e.g., 60mi, 28mph"
        },
        {
          "type": "select",
          "id": "spec1_style",
          "label": "Spec 1 Value Color",
          "options": [
            { "value": "default", "label": "Dark (#1A1C1C)" },
            { "value": "gold", "label": "Gold (#785a00)" }
          ],
          "default": "default"
        },
        {
          "type": "text",
          "id": "spec2_label",
          "label": "Spec 2 Label"
        },
        {
          "type": "text",
          "id": "spec2_value",
          "label": "Spec 2 Value"
        },
        {
          "type": "select",
          "id": "spec2_style",
          "label": "Spec 2 Value Color",
          "options": [
            { "value": "default", "label": "Dark (#1A1C1C)" },
            { "value": "gold", "label": "Gold (#785a00)" }
          ],
          "default": "gold"
        },
        {
          "type": "text",
          "id": "spec3_label",
          "label": "Spec 3 Label"
        },
        {
          "type": "text",
          "id": "spec3_value",
          "label": "Spec 3 Value"
        },
        {
          "type": "select",
          "id": "spec3_style",
          "label": "Spec 3 Value Color",
          "options": [
            { "value": "default", "label": "Dark (#1A1C1C)" },
            { "value": "gold", "label": "Gold (#785a00)" }
          ],
          "default": "default"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Add to Cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Page"
    }
  ]
}
{% endschema %}