{% comment %}MAXFOOT Hero Banner Section{% endcomment %}

{%- style -%}
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 870px;
    background-color: #FFFFFF;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-placeholder-bg {
    width: 100%;
    height: 100%;
    background-color: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-placeholder-bg span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #9ca3af;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.2) 100%);
    z-index: 2;
  }

  .hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 870px;
    max-width: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: stretch;
  }

  .hero-content {
    width: 50%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 64px;
    background-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
  }

  .hero-badge {
    background-color: #FFC426;
    color: #785a00;
    padding: 6px 16px;
    margin-bottom: 24px;
    border-radius: 4px;
    width: fit-content;
  }

  .hero-badge span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1A1C1C;
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: #FFC426;
  }

  .hero-description {
    font-family: 'Lexend', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #4f4633;
    margin-bottom: 40px;
    max-width: 480px;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    width: fit-content;
  }

  .hero-btn-primary:hover {
    opacity: 0.9;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 989px) {
    .hero-section {
      min-height: auto;
      display: flex;
      flex-direction: column;
      padding-top: 0;
      padding-bottom: 0;
    }

    .hero-media {
      position: relative;
      height: 55vh;
      order: 1;
    }

    .hero-overlay {
      display: none;
    }

    .hero-container {
      position: relative;
      height: auto;
      flex-direction: column;
      order: 2;
    }

    .hero-content {
      width: 100%;
      height: auto;
      padding: 32px 24px;
      background-color: #FFFFFF;
      justify-content: flex-start;
    }

    .hero-badge {
      margin-bottom: 16px;
      padding: 4px 12px;
    }

    .hero-badge span {
      font-size: 10px;
    }

    .hero-title {
      font-size: clamp(28px, 7vw, 40px);
      margin-bottom: 16px;
    }

    .hero-description {
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 24px;
      max-width: 100%;
    }

    .hero-btn-primary {
      font-size: 12px;
      padding: 12px 24px;
      width: 100%;
      text-align: center;
    }
  }
{%- endstyle -%}

<section class="hero-section">
  <div class="hero-media">
    {%- if section.settings.image_pc != blank -%}
      <img
        src="{{ section.settings.image_pc | image_url: width: 1920 }}"
        alt="{{ section.settings.image_pc.alt | escape }}"
        class="hero-image"
        loading="eager"
      >
    {%- else -%}
      <div class="hero-placeholder-bg">
        <span>UPLOAD HERO IMAGE</span>
      </div>
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-container">
    <div class="hero-content">
      {%- if section.settings.badge_text != blank -%}
        <div class="hero-badge">
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="hero-title">
          {{ section.settings.title }}
          {%- if section.settings.title_highlight != blank -%}
            <span class="highlight">{{ section.settings.title_highlight }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="hero-description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_primary_text != blank -%}
        <a href="{{ section.settings.button_primary_link }}" class="hero-btn-primary">
          {{ section.settings.button_primary_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Hero Image (PC)",
      "info": "Recommended size: 1920x870px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Recommended size: 800x600px"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "info": "e.g., NEW GENERATION E-BIKE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight Word",
      "info": "The word displayed in gold/highlight color"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}