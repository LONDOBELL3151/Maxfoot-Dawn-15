{% comment %}MAXFOOT Hero Banner Section{% endcomment %}

{%- style -%}
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 870px;
    display: flex;
    align-items: center;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-placeholder-bg {
    width: 100%;
    height: 100%;
    background-color: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-placeholder-bg span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #9ca3af;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0.3) 100%);
    z-index: 2;
  }

  .hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: center;
  }

  .hero-content {
    grid-column: span 6;
    padding: 48px 32px;
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 16px;
    backdrop-filter: blur(8px);
  }

  .hero-badge {
    display: inline-block;
    background-color: #FFC426;
    color: #785a00;
    padding: 4px 16px;
    margin-bottom: 24px;
    border-radius: 4px;
  }

  .hero-badge span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #1A1C1C;
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: #FFC426;
  }

  .hero-description {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #4f4633;
    margin-bottom: 40px;
    max-width: 520px;
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media screen and (min-width: 640px) {
    .hero-buttons {
      flex-direction: row;
    }
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 16px 40px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .hero-btn-primary:hover {
    opacity: 0.9;
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 40px;
    border: 2px solid #1A1C1C;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero-btn-secondary:hover {
    background-color: #1A1C1C;
    color: #FFFFFF;
  }

  .hero-spacer {
    grid-column: span 1;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 989px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 24px;
    }

    .hero-content {
      grid-column: span 1;
      padding: 48px 0 0 0;
      order: 2;
    }

    .hero-spacer {
      display: none;
    }

    .hero-overlay {
      background: linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
    }

    .hero-section {
      min-height: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .hero-content {
      padding: 32px 0 0 0;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      text-align: center;
      padding: 14px 24px;
      font-size: 14px;
    }

    .hero-section {
      min-height: auto;
    }
  }
{%- endstyle -%}

<section class="hero-section">
  <div class="hero-media">
    {%- if section.settings.image_pc != blank -%}
      <img
        src="{{ section.settings.image_pc | image_url: width: 1920 }}"
        alt="{{ section.settings.image_pc.alt | escape }}"
        class="hero-image"
        loading="eager"
      >
    {%- else -%}
      <div class="hero-placeholder-bg">
        <span>UPLOAD HERO IMAGE</span>
      </div>
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>NEW GENERATION E-BIKE</span>
      </div>
      <h1 class="hero-title">
        Unleash the <span class="highlight">RAW</span> Power
      </h1>
      <p class="hero-description">
        Meet the M-3, a high-torque beast engineered for those who demand uncompromising performance on every terrain. Experience the pinnacle of electric propulsion.
      </p>
      <div class="hero-buttons">
        {%- if section.settings.button_primary_text != blank -%}
          <a href="{{ section.settings.button_primary_link }}" class="hero-btn-primary">
            {{ section.settings.button_primary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-primary">PRE-ORDER NOW</a>
        {%- endif -%}
        {%- if section.settings.button_secondary_text != blank -%}
          <a href="{{ section.settings.button_secondary_link }}" class="hero-btn-secondary">
            {{ section.settings.button_secondary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-secondary">TECHNICAL SPECS</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero-spacer"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Hero Image (PC)",
      "info": "Recommended size: 1920x870px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Recommended size: 800x600px"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Primary Button Text",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary Button Text",
      "default": "TECHNICAL SPECS"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}