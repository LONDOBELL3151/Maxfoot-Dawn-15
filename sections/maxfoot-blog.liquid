{% comment %}MAXFOOT Blog Display Section{% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .blog-section {
    padding: 80px 0;
    background-color: #F9F9F9;
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding: 0 3.2rem;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1A1C1C;
    margin: 0;
  }

  .blog-view-all {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #785a00;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .blog-view-all:hover {
    color: #FFC426;
    gap: 0.75rem;
  }

  .blog-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 3.2rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .blog-card {
    background: #FFFFFF;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(26,28,28,0.08);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .blog-card:hover {
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    transform: translateY(-4px);
  }

  .blog-card-media {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .blog-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-card-media img {
    transform: scale(1.05);
  }

  .blog-card-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: #FFC426;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    border-radius: 20px;
  }

  .blog-card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .blog-card-date {
    font-family: 'Lexend', sans-serif;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .blog-card-author {
    font-family: 'Lexend', sans-serif;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .blog-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #1A1C1C;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-excerpt {
    font-family: 'Lexend', sans-serif;
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .blog-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #785a00;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .blog-card-button:hover {
    color: #FFC426;
    gap: 0.75rem;
  }

  .blog-card-button svg {
    transition: transform 0.3s ease;
  }

  .blog-card-button:hover svg {
    transform: translateX(4px);
  }

  /* Mobile responsive */
  @media screen and (max-width: 989px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .blog-section {
      padding: 60px 0;
    }

    .blog-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card-content {
      padding: 1.25rem;
    }
  }
{%- endstyle -%}

<section class="blog-section">
  <div class="blog-header">
    {%- if section.settings.title != blank -%}
      <h2 class="blog-title">{{ section.settings.title }}</h2>
    {%- else -%}
      <h2 class="blog-title">FROM THE JOURNAL</h2>
    {%- endif -%}

    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="blog-view-all">
        {{ section.settings.view_all_text | default: 'VIEW ALL POSTS' }}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

  <div class="blog-container">
    {%- if section.blocks.size > 0 -%}
      <div class="blog-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'post' -%}
            <a href="{{ block.settings.article.url }}" class="blog-card" {{ block.shopify_attributes }}>
              <div class="blog-card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="375"
                  >
                {%- elsif block.settings.article != blank -%}
                  <img
                    src="{{ block.settings.article.image | image_url: width: 600 }}"
                    alt="{{ block.settings.article.title | escape }}"
                    loading="lazy"
                    width="600"
                    height="375"
                  >
                {%- else -%}
                  <div class="placeholder-bg" style="background-color: #e5e5e5; height: 100%; display: flex; align-items: center; justify-content: center;">
                    <span style="color: #9ca3af; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;">BLOG IMAGE</span>
                  </div>
                {%- endif -%}

                {%- if block.settings.label != blank -%}
                  <span class="blog-card-label">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>

              <div class="blog-card-content">
                <div class="blog-card-meta">
                  {%- if block.settings.article != blank and block.settings.article.metafields.custom.author.value != blank -%}
                    <span class="blog-card-author">{{ block.settings.article.metafields.custom.author.value }}</span>
                  {%- elsif block.settings.author != blank -%}
                    <span class="blog-card-author">{{ block.settings.author }}</span>
                  {%- endif -%}

                  {%- if block.settings.article != blank and block.settings.article.published_at != blank -%}
                    <span class="blog-card-date">{{ block.settings.article.published_at | date: '%B %d, %Y' }}</span>
                  {%- elsif block.settings.date != blank -%}
                    <span class="blog-card-date">{{ block.settings.date }}</span>
                  {%- endif -%}
                </div>

                <h3 class="blog-card-title">
                  {%- if block.settings.article != blank -%}
                    {{ block.settings.article.title }}
                  {%- else -%}
                    {{ block.settings.title | default: 'Blog Post Title' }}
                  {%- endif -%}
                </h3>

                <p class="blog-card-excerpt">
                  {%- if block.settings.article != blank and block.settings.article.excerpt != blank -%}
                    {{ block.settings.article.excerpt }}
                  {%- else -%}
                    {{ block.settings.excerpt | default: 'Read more about this article and discover insights on electric biking, adventure stories, and more.' }}
                  {%- endif -%}
                </p>

                <span class="blog-card-button">
                  READ MORE
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="blog-grid">
        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div class="placeholder-bg" style="background-color: #e5e5e5; height: 100%; display: flex; align-items: center; justify-content: center;">
              <span style="color: #9ca3af; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">GUIDES</span>
          </div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-author">By MAXFOOT Team</span>
              <span class="blog-card-date">January 15, 2026</span>
            </div>
            <h3 class="blog-card-title">Ultimate Guide to Electric Bike Maintenance</h3>
            <p class="blog-card-excerpt">Learn essential maintenance tips to keep your MAXFOOT e-bike running smoothly for years to come.</p>
            <span class="blog-card-button">
              READ MORE
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div class="placeholder-bg" style="background-color: #e5e5e5; height: 100%; display: flex; align-items: center; justify-content: center;">
              <span style="color: #9ca3af; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">ADVENTURE</span>
          </div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-author">By Sarah Chen</span>
              <span class="blog-card-date">January 08, 2026</span>
            </div>
            <h3 class="blog-card-title">5 Scenic E-Bike Trails You Must Explore in 2026</h3>
            <p class="blog-card-excerpt">Discover breathtaking routes perfect for your MAXFOOT e-bike, from coastal highways to mountain passes.</p>
            <span class="blog-card-button">
              READ MORE
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="#" class="blog-card">
          <div class="blog-card-media">
            <div class="placeholder-bg" style="background-color: #e5e5e5; height: 100%; display: flex; align-items: center; justify-content: center;">
              <span style="color: #9ca3af; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;">BLOG IMAGE</span>
            </div>
            <span class="blog-card-label">TECHNOLOGY</span>
          </div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-author">By James Thompson</span>
              <span class="blog-card-date">December 28, 2025</span>
            </div>
            <h3 class="blog-card-title">Understanding MAXFOOT Motor Technology</h3>
            <p class="blog-card-excerpt">Deep dive into how our 750W motors deliver unparalleled power and efficiency for any terrain.</p>
            <span class="blog-card-button">
              READ MORE
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Display",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "FROM THE JOURNAL"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "VIEW ALL POSTS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Blog Post",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Select Article",
          "info": "Leave empty to use manual fields below"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Leave empty to use article image. Recommended size: 600x375px"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Label",
          "info": "e.g., GUIDES, ADVENTURE, TECHNOLOGY"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Leave empty to use article title"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "info": "Leave empty to use article author"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "Leave empty to use article date"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "info": "Leave empty to use article excerpt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Display",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}