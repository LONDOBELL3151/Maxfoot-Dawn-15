{% comment %}MAXFOOT Custom Footer{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme-3" style="background-color: #1A1C1C; margin-top: 0;">
  <div class="page-width" style="max-width: 1440px; margin: 0 auto; padding: 0 3.2rem;">
    <!-- Footer Top -->
    <div class="footer__content-top footer-grid" style="padding: 6rem 0;">
      <!-- Brand Column -->
      <div class="footer-block footer-block--brand" style="text-align: left;">
        <h2 class="footer-block__brand-title">MAXFOOT</h2>
        <p class="footer-block__brand-text">
          Pioneering the future of electric mobility with high-performance bikes designed for the modern adventurer.
        </p>
        <div class="footer-block__social">
          <a href="#" aria-label="Instagram">
            <span class="svg-wrapper">{{ 'icon-instagram.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="Facebook">
            <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="YouTube">
            <span class="svg-wrapper">{{ 'icon-youtube.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="TikTok">
            <span class="svg-wrapper">{{ 'icon-tiktok.svg' | inline_asset_content }}</span>
          </a>
        </div>
      </div>

      <!-- Support Column -->
      <div class="footer-block footer-block--menu footer-accordion" style="text-align: left;">
        <button class="footer-accordion__header" onclick="toggleAccordion(this)" style="background: none; border: none; cursor: pointer; width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0; margin-bottom: 0;">
          <h2 class="footer-block__heading" style="color: #FFFFFF; margin: 0;">SUPPORT</h2>
          <span class="footer-accordion__icon" style="color: #FFC426; font-size: 12px; transition: transform 0.3s ease;">▼</span>
        </button>
        <ul class="footer-accordion__content" style="list-style: none; padding: 0; margin: 1.5rem 0 0 0; text-align: left; display: none;">
          {%- for link in linklists[section.settings.menu].links -%}
            <li style="margin-bottom: 0.75rem; text-align: left;">
              <a href="{{ link.url }}" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; transition: color 0.2s ease; display: inline; text-align: left;"
                 onmouseover="this.style.color='#FFC426'" onmouseout="this.style.color='#9ca3af'">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor %}
        </ul>
      </div>

      <!-- Company Column -->
      <div class="footer-block footer-block--menu footer-accordion" style="text-align: left;">
        <button class="footer-accordion__header" onclick="toggleAccordion(this)" style="background: none; border: none; cursor: pointer; width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0; margin-bottom: 0;">
          <h2 class="footer-block__heading" style="color: #FFFFFF; margin: 0;">COMPANY</h2>
          <span class="footer-accordion__icon" style="color: #FFC426; font-size: 12px; transition: transform 0.3s ease;">▼</span>
        </button>
        <ul class="footer-accordion__content" style="list-style: none; padding: 0; margin: 1.5rem 0 0 0; text-align: left; display: none;">
          <li style="margin-bottom: 0.75rem; text-align: left;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; display: inline;">About Us</a></li>
          <li style="margin-bottom: 0.75rem; text-align: left;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; display: inline;">Careers</a></li>
          <li style="margin-bottom: 0.75rem; text-align: left;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; display: inline;">Press</a></li>
          <li style="margin-bottom: 0.75rem; text-align: left;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; display: inline;">Sustainability</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-block footer-block--newsletter" style="text-align: left;">
        <h2 class="footer-block__heading">NEWSLETTER</h2>
        <p class="footer-block__newsletter-text">Stay updated with the latest models and exclusive offers.</p>
        <div class="newsletter-form-inner">
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="YOUR EMAIL"
            required
          >
          <button type="submit" aria-label="Subscribe">
            {{ 'icon-arrow.svg' | inline_asset_content }}
          </button>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer__content-bottom" style="border-top: 1px solid #374151; padding: 2rem 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div class="copyright__content" style="color: #6b7280;">
        &copy; {{ 'now' | date: '%Y' }} MAXFOOT ELECTRIC BIKES. ENGINEERED FOR ADVENTURE.
      </div>
      <div style="display: flex; gap: 2rem;">
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">PRIVACY</a>
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">WARRANTY</a>
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">TERMS</a>
      </div>
    </div>
  </div>
</footer>

<script>
function toggleAccordion(el) {
  const content = el.nextElementSibling;
  const icon = el.querySelector('.footer-accordion__icon');
  if (content.classList.contains('active')) {
    content.classList.remove('active');
    content.style.display = 'none';
    icon.style.transform = 'rotate(0deg)';
  } else {
    content.classList.add('active');
    content.style.display = 'block';
    icon.style.transform = 'rotate(180deg)';
  }
}
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menu",
      "info": "Select menu for footer links"
    }
  ]
}
{% endschema %}