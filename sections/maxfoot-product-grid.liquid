{% comment %}MAXFOOT Product Grid Section{% endcomment %}

{%- style -%}
  .product-grid-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #FFFFFF;
  }

  .product-grid-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .product-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .product-grid-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1A1C1C;
    margin: 0;
    text-transform: uppercase;
  }

  .product-grid-view-all {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFC426;
    text-decoration: none;
    border-bottom: 2px solid #FFC426;
    padding-bottom: 4px;
    transition: opacity 0.2s ease;
  }

  .product-grid-view-all:hover {
    opacity: 0.8;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* Product Card */
  .product-card {
    background: #FAFAFA;
    border: 1px solid #E5E5E5;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-card:hover {
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }

  .product-card-media {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #F5F5F5;
    overflow: hidden;
  }

  .product-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 32px;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card-media img {
    transform: scale(1.05);
  }

  .product-card-label {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: #FFC426;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    z-index: 2;
  }

  /* Image banner bar - nested inside media */
  .product-card-banner {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #1A1C1C;
    color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 10px 16px;
    z-index: 3;
  }

  .product-card-content {
    padding: 24px;
  }

  .product-card-meta {
    margin-bottom: 12px;
  }

  .product-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #1A1C1C;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .product-card-subtitle {
    font-family: 'Lexend', sans-serif;
    font-size: 13px;
    color: #6B7280;
    margin: 0;
    line-height: 1.4;
  }

  /* Price + Review split layout */
  .product-card-pricing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-top: 12px;
    border-top: 1px solid #E5E5E5;
  }

  .pricing-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-card-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFC426;
  }

  .product-card-compare-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .pricing-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .review-star {
    width: 16px;
    height: 16px;
    color: #FFC426;
  }

  .review-score {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1A1C1C;
  }

  /* Button */
  .product-card-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 16px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .product-card-btn:hover {
    opacity: 0.9;
  }

  /* Responsive */
  @media screen and (max-width: 989px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .product-grid-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .product-grid-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .product-grid-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .product-grid-container {
      padding: 0 24px;
    }

    .product-card-content {
      padding: 20px;
    }

    .product-card-title {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<section class="product-grid-section">
  <div class="product-grid-container">
    <div class="product-grid-header">
      <h2 class="product-grid-title">{{ section.settings.title | default: 'HOT SELLING' }}</h2>
      <a href="{{ section.settings.view_all_link }}" class="product-grid-view-all">
        {{ section.settings.view_all_text | default: 'VIEW ALL PRODUCTS' }}
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="product-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- assign product = all_products[block.settings.product] -%}
            {%- if product != blank -%}
              <div class="product-card" {{ block.shopify_attributes }}>
                <div class="product-card-media">
                  {%- if block.settings.label != blank -%}
                    <span class="product-card-label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
                  {%- else -%}
                    <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- endif -%}
                  {%- if block.settings.banner_text != blank -%}
                    <div class="product-card-banner">{{ block.settings.banner_text }}</div>
                  {%- endif -%}
                </div>
                <div class="product-card-content">
                  <div class="product-card-meta">
                    <h3 class="product-card-title">{{ block.settings.title | default: product.title }}</h3>
                    {%- if block.settings.subtitle != blank -%}
                      <p class="product-card-subtitle">{{ block.settings.subtitle }}</p>
                    {%- endif -%}
                  </div>
                  <div class="product-card-pricing">
                    <div class="pricing-left">
                      <span class="product-card-price">{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="product-card-compare-price">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                    <div class="pricing-right">
                      <svg class="review-star" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                      <span class="review-score">{{ block.settings.review_score | default: '4.9' }}</span>
                    </div>
                  </div>
                  {%- if block.settings.button_text != blank -%}
                    <a href="{{ product.url }}" class="product-card-btn">{{ block.settings.button_text }}</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid">
        <div class="product-card">
          <div class="product-card-media">
            <span class="product-card-label">HOT</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
            <div class="product-card-banner">FREE SHIPPING</div>
          </div>
          <div class="product-card-content">
            <div class="product-card-meta">
              <h3 class="product-card-title">MAXFOOT M-1</h3>
              <p class="product-card-subtitle">Step-thru Commuter</p>
            </div>
            <div class="product-card-pricing">
              <div class="pricing-left">
                <span class="product-card-price">$1,299.00</span>
              </div>
              <div class="pricing-right">
                <svg class="review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="review-score">4.9</span>
              </div>
            </div>
            <a href="#" class="product-card-btn">SHOP NOW</a>
          </div>
        </div>
        <div class="product-card">
          <div class="product-card-media">
            <span class="product-card-label">HOT</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="product-card-content">
            <div class="product-card-meta">
              <h3 class="product-card-title">MAXFOOT M-2</h3>
              <p class="product-card-subtitle">750W Front Suspension</p>
            </div>
            <div class="product-card-pricing">
              <div class="pricing-left">
                <span class="product-card-price">$1,499.00</span>
              </div>
              <div class="pricing-right">
                <svg class="review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="review-score">4.8</span>
              </div>
            </div>
            <a href="#" class="product-card-btn">SHOP NOW</a>
          </div>
        </div>
        <div class="product-card">
          <div class="product-card-media">
            <span class="product-card-label">HOT</span>
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          </div>
          <div class="product-card-content">
            <div class="product-card-meta">
              <h3 class="product-card-title">MAXFOOT M-3</h3>
              <p class="product-card-subtitle">High Torque Beast</p>
            </div>
            <div class="product-card-pricing">
              <div class="pricing-left">
                <span class="product-card-price">$1,599.00</span>
                <span class="product-card-compare-price">$1,799.00</span>
              </div>
              <div class="pricing-right">
                <svg class="review-star" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="review-score">4.9</span>
              </div>
            </div>
            <a href="#" class="product-card-btn">SHOP NOW</a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "HOT SELLING"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Product Label",
          "info": "e.g., HOT, NEW, SALE"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "info": "Text below the title"
        },
        {
          "type": "text",
          "id": "banner_text",
          "label": "Image Banner Text",
          "info": "Text bar at bottom of image, hidden if empty"
        },
        {
          "type": "text",
          "id": "review_score",
          "label": "Review Score",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}