{{ 'section-product.css' | asset_url | stylesheet_tag }}

<section class="pdp-section" style="padding-top: {{ section.settings.padding_top }}px;">
  <div class="pdp-container">
    <div class="pdp-grid">
      <!-- Left: Image Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-main-image">
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" id="pdp-main-image">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f3f4;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
        <div class="pdp-thumbnails">
          {%- for image in product.images -%}
            <div class="pdp-thumbnail {% if forloop.first %}active{% endif %}" data-src="{{ image | image_url: width: 800 }}" onclick="changeMainImage(this)">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}">
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      <!-- Right: Product Info -->
      <div class="pdp-info">
        {%- if section.settings.badge_text != blank -%}
        <div class="pdp-badges">
          <span class="pdp-badge">{{ section.settings.badge_text | escape }}</span>
        </div>
        {%- endif -%}

        <h1 class="pdp-title">{{ product.title | escape }}</h1>

        {%- if product.description != blank -%}
        <p class="pdp-subtitle">{{ product.description | strip_html | truncate: 150 }}</p>
        {%- endif -%}

        <div class="pdp-price-wrap">
          <span class="pdp-price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
          <span class="pdp-compare-price">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_star_rating -%}
        <div class="pdp-badges">
          <div class="pdp-stars">
            {%- for i in (1..5) -%}
              {%- if i <= section.settings.star_count -%}
                <svg class="pdp-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- else -%}
                <svg class="pdp-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if section.settings.review_label != blank -%}
          <span class="pdp-badge" style="background:transparent;color:#5f5e5e;">{{ section.settings.review_label | escape }}</span>
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- if section.settings.promotion_badge != blank -%}
        <div class="pdp-promotion-box">
          <div class="pdp-promotion-header">
            <span class="pdp-promotion-badge">{{ section.settings.promotion_badge | escape }}</span>
          </div>
          {%- if section.settings.promotion_text != blank -%}
          <span class="pdp-promotion-text">{{ section.settings.promotion_text | escape }}</span>
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_color_selector -%}
        <div class="pdp-color-section">
          <p class="pdp-color-label">SELECT COLOR {% if section.settings.selected_color != blank %}- {{ section.settings.selected_color | escape }}{% endif %}</p>
          <div class="pdp-color-options">
            {%- for color in section.blocks -%}
              {%- if color.type == 'color' -%}
                <button class="pdp-color-btn {{ color.settings.color_name | downcase }} {% if forloop.first %}selected{% endif %}" data-color="{{ color.settings.color_name | escape }}" style="background-color: {{ color.settings.color_hex }};" onclick="selectColor(this)"></button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        <div class="pdp-quantity-section">
          <span class="pdp-quantity-label">QTY</span>
          <div class="pdp-quantity-control">
            <button class="pdp-quantity-btn" onclick="changeQuantity(-1)">-</button>
            <input type="number" class="pdp-quantity-input" id="pdp-quantity" value="1" min="1">
            <button class="pdp-quantity-btn" onclick="changeQuantity(1)">+</button>
          </div>
        </div>

        <div class="pdp-actions">
          <button class="pdp-add-to-cart" onclick="addToCart()">
            ADD TO CART
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <button class="pdp-wishlist-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
        </div>

        {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle_product' -%}
            {%- assign bundle_product = all_products[block.settings.product] -%}
            {%- if bundle_product != blank -%}
            <div class="pdp-bundle-section">
              {%- if forloop.first -%}
              <p class="pdp-bundle-title">BUNDLE & SAVE</p>
              {%- endif -%}
              <label class="pdp-bundle-item">
                <input type="checkbox" class="pdp-bundle-checkbox" data-bundle-id="{{ bundle_product.id }}" onchange="updateBundleSelection()">
                <img class="pdp-bundle-image" src="{{ bundle_product.featured_image | image_url: width: 120 }}" alt="{{ bundle_product.title | escape }}">
                <div class="pdp-bundle-details">
                  <p class="pdp-bundle-name">{{ bundle_product.title | escape }}</p>
                  <p class="pdp-bundle-price">{{ bundle_product.price | money }}</p>
                </div>
              </label>
            </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endif -%}

        <product-form class="product-form">
          {%- form 'product', product, id: 'product-form-installment', class: 'installment' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
            {%- endif -%}
          {%- endform -%}
        </product-form>
      </div>
    </div>
  </div>
</section>

<script>
let selectedQuantity = 1;
let selectedColor = '';

function changeMainImage(el) {
  document.querySelectorAll('.pdp-thumbnail').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('pdp-main-image').src = el.dataset.src;
}

function changeQuantity(delta) {
  let input = document.getElementById('pdp-quantity');
  let val = parseInt(input.value) + delta;
  if (val < 1) val = 1;
  input.value = val;
  selectedQuantity = val;
}

function selectColor(el) {
  document.querySelectorAll('.pdp-color-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  selectedColor = el.dataset.color;
}

function updateBundleSelection() {
  // Bundle selection is tracked via checkbox state
}

function addToCart() {
  const formData = new FormData();
  formData.append('id', '{{ product.selected_or_first_available_variant.id }}');
  formData.append('quantity', selectedQuantity);

  // Add bundle products if selected
  document.querySelectorAll('.pdp-bundle-checkbox:checked').forEach(cb => {
    formData.append('items[][id', cb.dataset.bundleId);
    formData.append('items[][quantity', '1');
  });

  fetch('/cart/add.js', {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(product => {
    window.location.href = '/cart';
  })
  .catch((error) => {
    console.error('Error:', error);
    alert('Unable to add to cart');
  });
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
  const firstColor = document.querySelector('.pdp-color-btn');
  if (firstColor) {
    selectedColor = firstColor.dataset.color;
  }
});
</script>

{% schema %}
{
  "name": "Product Detail",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "info": "e.g., BEST SELLER, NEW ARRIVAL"
    },
    {
      "type": "checkbox",
      "id": "enable_star_rating",
      "label": "Show Star Rating",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star Count",
      "default": 5
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review Label",
      "info": "e.g., Verified Owner"
    },
    {
      "type": "checkbox",
      "id": "show_color_selector",
      "label": "Show Color Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "selected_color",
      "label": "Selected Color Name",
      "info": "e.g., Matte Black"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Dynamic Checkout Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Promotion Box"
    },
    {
      "type": "text",
      "id": "promotion_badge",
      "label": "Promotion Badge",
      "info": "e.g., Mother's Day Offer"
    },
    {
      "type": "text",
      "id": "promotion_text",
      "label": "Promotion Text",
      "info": "e.g., Limited at $699 ~2026.5.11"
    }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Color Option",
      "settings": [
        {
          "type": "text",
          "id": "color_name",
          "label": "Color Name",
          "info": "e.g., Matte Black"
        },
        {
          "type": "color",
          "id": "color_hex",
          "label": "Color Hex"
        }
      ]
    },
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Bundle Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Detail"
    }
  ]
}
{% endschema %}