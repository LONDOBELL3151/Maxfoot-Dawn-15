{% comment %}MAXFOOT Custom Footer{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme-3" style="background-color: #1A1C1C; margin-top: 0;">
  <div class="page-width" style="max-width: 1440px; margin: 0 auto; padding: 0 3.2rem;">
    <!-- Footer Top -->
    <div class="footer__content-top" style="padding: 6rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem;">
      <!-- Brand Column -->
      <div class="footer-block footer-block--brand">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #FFFFFF; margin: 0 0 1rem 0;">MAXFOOT</h2>
        <p style="color: #9ca3af; font-family: 'Lexend', sans-serif; font-size: 0.875rem; line-height: 1.7; max-width: 280px; margin: 0;">
          Pioneering the future of electric mobility with high-performance bikes designed for the modern adventurer.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <a href="#" aria-label="Instagram" style="color: #FFC426;">
            <span class="svg-wrapper">{{ 'icon-instagram.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="Facebook" style="color: #FFC426;">
            <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="YouTube" style="color: #FFC426;">
            <span class="svg-wrapper">{{ 'icon-youtube.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="TikTok" style="color: #FFC426;">
            <span class="svg-wrapper">{{ 'icon-tiktok.svg' | inline_asset_content }}</span>
          </a>
        </div>
      </div>

      <!-- Support Column -->
      <div class="footer-block footer-block--menu">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #FFFFFF; margin: 0 0 1.5rem 0;">SUPPORT</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {%- for link in linklists[section.settings.menu].links -%}
            <li style="margin-bottom: 0.75rem;">
              <a href="{{ link.url }}" style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; text-decoration: none; transition: color 0.2s ease;"
                 onmouseover="this.style.color='#FFC426'" onmouseout="this.style.color='#9ca3af'">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Company Column -->
      <div class="footer-block footer-block--menu">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #FFFFFF; margin: 0 0 1.5rem 0;">COMPANY</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="margin-bottom: 0.75rem;"><a href="#" style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; text-decoration: none;">About Us</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; text-decoration: none;">Careers</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; text-decoration: none;">Press</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; text-decoration: none;">Sustainability</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-block footer-block--newsletter">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #FFFFFF; margin: 0 0 1.5rem 0;">NEWSLETTER</h2>
        <p style="font-family: 'Lexend', sans-serif; font-size: 0.875rem; color: #9ca3af; margin: 0 0 1.5rem 0;">Stay updated with the latest models and exclusive offers.</p>
        {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display: flex; border-bottom: 1px solid #4b5563; padding-bottom: 0.75rem; gap: 0.5rem;">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              style="background: transparent; border: none; color: #ffffff; font-family: 'Lexend', sans-serif; font-size: 0.875rem; flex: 1; outline: none;"
              placeholder="YOUR EMAIL"
              required
            >
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="Subscribe"
              style="background: transparent; border: none; color: #FFC426; cursor: pointer; padding: 0;"
            >
              <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <!-- Footer Bottom -->
    <div style="border-top: 1px solid #374151; padding: 2rem 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="color: #6b7280; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; letter-spacing: 0.1em;">
        &copy; {{ 'now' | date: '%Y' }} MAXFOOT ELECTRIC BIKES. ENGINEERED FOR ADVENTURE.
      </div>
      <div style="display: flex; gap: 2rem;">
        <a href="#" style="color: #6b7280; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;">PRIVACY</a>
        <a href="#" style="color: #6b7280; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;">WARRANTY</a>
        <a href="#" style="color: #6b7280; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;">TERMS</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menu",
      "info": "Select menu for footer links"
    }
  ]
}
{% endschema %}