{% comment %}MAXFOOT Custom Footer{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme-3" style="background-color: #1A1C1C; margin-top: 0;">
  <div class="page-width" style="max-width: 1440px; margin: 0 auto; padding: 0 3.2rem;">
    <!-- Footer Top -->
    <div class="footer__content-top" style="padding: 6rem 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem;">
      <!-- Brand Column -->
      <div class="footer-block footer-block--brand">
        <h2 class="footer-block__brand-title">MAXFOOT</h2>
        <p class="footer-block__brand-text">
          Pioneering the future of electric mobility with high-performance bikes designed for the modern adventurer.
        </p>
        <div class="footer-block__social">
          <a href="#" aria-label="Instagram">
            <span class="svg-wrapper">{{ 'icon-instagram.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="Facebook">
            <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="YouTube">
            <span class="svg-wrapper">{{ 'icon-youtube.svg' | inline_asset_content }}</span>
          </a>
          <a href="#" aria-label="TikTok">
            <span class="svg-wrapper">{{ 'icon-tiktok.svg' | inline_asset_content }}</span>
          </a>
        </div>
      </div>

      <!-- Support Column -->
      <div class="footer-block footer-block--menu">
        <h2 class="footer-block__heading" style="color: #FFFFFF;">SUPPORT</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {%- for link in linklists[section.settings.menu].links -%}
            <li style="margin-bottom: 0.75rem;">
              <a href="{{ link.url }}" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none; transition: color 0.2s ease;"
                 onmouseover="this.style.color='#FFC426'" onmouseout="this.style.color='#9ca3af'">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor %}
        </ul>
      </div>

      <!-- Company Column -->
      <div class="footer-block footer-block--menu">
        <h2 class="footer-block__heading" style="color: #FFFFFF;">COMPANY</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="margin-bottom: 0.75rem;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none;">About Us</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none;">Careers</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none;">Press</a></li>
          <li style="margin-bottom: 0.75rem;"><a href="#" class="list-menu__item--link" style="color: #9ca3af; text-decoration: none;">Sustainability</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-block footer-block--newsletter">
        <h2 class="footer-block__heading">NEWSLETTER</h2>
        <p class="footer-block__newsletter-text">Stay updated with the latest models and exclusive offers.</p>
        <div style="display:flex;align-items:center;border-bottom:1px solid #4b5563;padding-bottom:0.75rem;gap:0.5rem;max-width:280px;">
          <input
            id="NewsletterForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="YOUR EMAIL"
            required
            style="background:transparent;border:none;color:#ffffff;font-family:'Lexend',sans-serif;font-size:14px;flex:1;outline:none;padding:0;"
          >
          <button
            type="submit"
            style="background:transparent;border:none;color:#FFC426;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center;"
          >
            <span style="width:20px;height:20px;display:flex;">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer__content-bottom" style="border-top: 1px solid #374151; padding: 2rem 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div class="copyright__content" style="color: #6b7280;">
        &copy; {{ 'now' | date: '%Y' }} MAXFOOT ELECTRIC BIKES. ENGINEERED FOR ADVENTURE.
      </div>
      <div style="display: flex; gap: 2rem;">
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">PRIVACY</a>
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">WARRANTY</a>
        <a href="#" class="copyright__content" style="color: #6b7280; text-decoration: none;">TERMS</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menu",
      "info": "Select menu for footer links"
    }
  ]
}
{% endschema %}