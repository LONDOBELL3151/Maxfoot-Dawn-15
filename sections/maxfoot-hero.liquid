{% comment %}MAXFOOT Hero Banner Section{% endcomment %}

{%- style -%}
  .hero-section {
    position: relative;
    background-color: #FFFFFF;
    width: 100%;
    min-height: 870px;
    display: flex;
    align-items: center;
  }

  .hero-container {
    width: 100%;
    max-width: none;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: center;
  }

  .hero-content {
    grid-column: span 6;
    z-index: 10;
    padding: 48px 0;
  }

  .hero-badge {
    display: inline-block;
    background-color: #FFC426;
    color: #785a00;
    padding: 4px 16px;
    margin-bottom: 24px;
    border-radius: 4px;
  }

  .hero-badge span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #1A1C1C;
    margin-bottom: 24px;
  }

  .hero-title .highlight {
    color: #FFC426;
  }

  .hero-description {
    font-family: 'Lexend', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #4f4633;
    margin-bottom: 40px;
    max-width: 520px;
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 16px;
    sm-flex-direction: row;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #FFC426;
    color: #785a00;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 16px 40px;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .hero-btn-primary:hover {
    opacity: 0.9;
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #1A1C1C;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 40px;
    border: 2px solid #1A1C1C;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hero-btn-secondary:hover {
    background-color: #1A1C1C;
    color: #FFFFFF;
  }

  .hero-media {
    grid-column: span 6;
    position: relative;
    height: 700px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.1);
  }

  .hero-placeholder {
    width: 100%;
    height: 100%;
    background-color: #f3f3f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-placeholder span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #9ca3af;
  }

  .hero-decorative {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(from #f5f5f5 to transparent, circle);
    opacity: 0.5;
    border-radius: 50%;
    z-index: -1;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 989px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-content {
      grid-column: span 1;
      padding: 48px 0 0 0;
      order: 2;
    }

    .hero-media {
      grid-column: span 1;
      height: 400px;
      order: 1;
    }

    .hero-buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 749px) {
    .hero-section {
      min-height: auto;
    }

    .hero-container {
      padding: 0 24px;
    }

    .hero-content {
      padding: 32px 0 0 0;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      text-align: center;
      padding: 14px 24px;
      font-size: 14px;
    }
  }
{%- endstyle -%}

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span>NEW GENERATION E-BIKE</span>
      </div>
      <h1 class="hero-title">
        Unleash the <span class="highlight">RAW</span> Power
      </h1>
      <p class="hero-description">
        Meet the M-3, a high-torque beast engineered for those who demand uncompromising performance on every terrain. Experience the pinnacle of electric propulsion.
      </p>
      <div class="hero-buttons">
        {%- if section.settings.button_primary_text != blank -%}
          <a href="{{ section.settings.button_primary_link }}" class="hero-btn-primary">
            {{ section.settings.button_primary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-primary">PRE-ORDER NOW</a>
        {%- endif -%}
        {%- if section.settings.button_secondary_text != blank -%}
          <a href="{{ section.settings.button_secondary_link }}" class="hero-btn-secondary">
            {{ section.settings.button_secondary_text }}
          </a>
        {%- else -%}
          <a href="#" class="hero-btn-secondary">TECHNICAL SPECS</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-decorative"></div>
      {%- if section.settings.image_pc != blank -%}
        <img
          src="{{ section.settings.image_pc | image_url: width: 800 }}"
          alt="{{ section.settings.image_pc.alt | escape }}"
          class="hero-image"
          loading="eager"
        >
      {%- else -%}
        <div class="hero-placeholder">
          <span>UPLOAD HERO IMAGE</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Hero Image (PC)",
      "info": "Recommended size: 800x700px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image (Mobile)",
      "info": "Recommended size: 800x600px"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Primary Button Text",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary Button Text",
      "default": "TECHNICAL SPECS"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}