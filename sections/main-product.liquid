{{ 'section-product.css' | asset_url | stylesheet_tag }}

<section class="pdp-section" style="padding-top: {{ section.settings.padding_top }}px;">
  <div class="pdp-container">
    <div class="pdp-grid">
      <!-- Left: Image Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-main-image">
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" id="pdp-main-image">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f3f4;">
              <span style="font-family:'Space Grotesk';color:#9ca3af;font-size:12px;letter-spacing:0.1em;">PRODUCT IMAGE</span>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
        <div class="pdp-thumbnails">
          {%- for image in product.images -%}
            <div class="pdp-thumbnail {% if forloop.first %}active{% endif %}" data-src="{{ image | image_url: width: 800 }}" onclick="changeMainImage(this)">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}">
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      <!-- Right: Product Info -->
      <div class="pdp-info">
        {%- form 'product', product, class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                <div class="pdp-badges" {{ block.shopify_attributes }}>
                  <span class="pdp-badge">{{ block.settings.text | escape }}</span>
                </div>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="pdp-title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                <p class="pdp-subtitle" {{ block.shopify_attributes }}>{{ product.description | strip_html | truncate: block.settings.truncate_count | default: 150 }}</p>
                {%- endif -%}

              {%- when 'price' -%}
                <div class="pdp-price-wrap" {{ block.shopify_attributes }}>
                  <span class="pdp-price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                  <span class="pdp-compare-price">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                {%- if block.settings.enable_star_rating -%}
                <div class="pdp-badges" {{ block.shopify_attributes }}>
                  <div class="pdp-stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.star_count -%}
                        <svg class="pdp-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      {%- else -%}
                        <svg class="pdp-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.review_label != blank -%}
                  <span class="pdp-badge" style="background:transparent;color:#5f5e5e;">{{ block.settings.review_label | escape }}</span>
                  {%- endif -%}
                </div>
                {%- endif -%}

              {%- when 'promotion' -%}
                {%- if block.settings.promotion_badge != blank -%}
                <div class="pdp-promotion-box" {{ block.shopify_attributes }}>
                  {%- if block.settings.promotion_badge != blank -%}
                  <div class="pdp-promotion-header">
                    <span class="pdp-promotion-badge">{{ block.settings.promotion_badge | escape }}</span>
                  </div>
                  {%- endif -%}
                  {%- if block.settings.promotion_text != blank -%}
                  <span class="pdp-promotion-text">{{ block.settings.promotion_text | escape }}</span>
                  {%- endif -%}
                </div>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="pdp-variant-section" {{ block.shopify_attributes }}>
                    {% render 'product-variant-picker', product: product, block: block, product_form_id: 'product-form-' | append: section.id %}
                  </div>
                {%- endunless -%}

              {%- when 'quantity_selector' -%}
                <div class="pdp-quantity-section" {{ block.shopify_attributes }}>
                  <span class="pdp-quantity-label">{{ block.settings.quantity_label | default: 'QTY' }}</span>
                  <div class="pdp-quantity-control">
                    <button type="button" class="pdp-quantity-btn" onclick="changeQuantity(-1)">-</button>
                    <input type="number" class="pdp-quantity-input" id="pdp-quantity" name="quantity" value="1" min="1">
                    <button type="button" class="pdp-quantity-btn" onclick="changeQuantity(1)">+</button>
                  </div>
                </div>

              {%- when 'buy_buttons' -%}
                <div class="pdp-actions" {{ block.shopify_attributes }}>
                  <button type="submit" class="pdp-add-to-cart" onclick="addToCart()">
                    {{ block.settings.button_text | default: 'ADD TO CART' }}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </button>
                  <button type="button" class="pdp-wishlist-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                </div>

              {%- when 'bundle_product' -%}
                {%- assign bundle_product = all_products[block.settings.product] -%}
                {%- if bundle_product != blank -%}
                <div class="pdp-bundle-section" {{ block.shopify_attributes }}>
                  {%- if forloop.first -%}
                  <p class="pdp-bundle-title">{{ block.settings.bundle_title | default: 'BUNDLE & SAVE' }}</p>
                  {%- endif -%}
                  <label class="pdp-bundle-item">
                    <input type="checkbox" class="pdp-bundle-checkbox" data-bundle-id="{{ bundle_product.id }}" onchange="updateBundleSelection()">
                    <img class="pdp-bundle-image" src="{{ bundle_product.featured_image | image_url: width: 120 }}" alt="{{ bundle_product.title | escape }}">
                    <div class="pdp-bundle-details">
                      <p class="pdp-bundle-name">{{ bundle_product.title | escape }}</p>
                      <p class="pdp-bundle-price">{{ bundle_product.price | money }}</p>
                    </div>
                  </label>
                </div>
                {%- endif -%}

              {%- when 'dynamic_checkout' -%}
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="pdp-dynamic-checkout" {{ block.shopify_attributes }}>
                    {{ form | payment_button }}
                  </div>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script>
let selectedQuantity = 1;

function changeMainImage(el) {
  document.querySelectorAll('.pdp-thumbnail').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('pdp-main-image').src = el.dataset.src;
}

function changeQuantity(delta) {
  let input = document.getElementById('pdp-quantity');
  let val = parseInt(input.value) + delta;
  if (val < 1) val = 1;
  input.value = val;
  selectedQuantity = val;
}

function updateBundleSelection() {}

function addToCart() {
  const form = document.querySelector('.product-form');
  const formData = new FormData(form);
  formData.set('quantity', selectedQuantity);

  fetch('/cart/add.js', {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(product => {
    window.location.href = '/cart';
  })
  .catch((error) => {
    console.error('Error:', error);
    alert('Unable to add to cart');
  });
}
</script>

{% schema %}
{
  "name": "Product Detail",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Badge / Label",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "info": "e.g., BEST SELLER, NEW ARRIVAL"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "truncate_count",
          "min": 50,
          "max": 300,
          "step": 10,
          "label": "Character Limit",
          "default": 150
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Star Rating",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_star_rating",
          "label": "Show Star Rating",
          "default": true
        },
        {
          "type": "range",
          "id": "star_count",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Count",
          "default": 5
        },
        {
          "type": "text",
          "id": "review_label",
          "label": "Review Label",
          "info": "e.g., Verified Owner"
        }
      ]
    },
    {
      "type": "promotion",
      "name": "Promotion Box",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "promotion_badge",
          "label": "Promotion Badge",
          "info": "e.g., Mother's Day Offer"
        },
        {
          "type": "text",
          "id": "promotion_text",
          "label": "Promotion Text",
          "info": "e.g., Limited at $699"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker Type",
          "options": [
            { "value": "button", "label": "Button" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "button"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Quantity Label",
          "default": "QTY"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Add to Cart Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "ADD TO CART"
        }
      ]
    },
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Bundle Product"
        },
        {
          "type": "text",
          "id": "bundle_title",
          "label": "Bundle Section Title",
          "default": "BUNDLE & SAVE"
        }
      ]
    },
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Bundle Product"
        },
        {
          "type": "text",
          "id": "bundle_title",
          "label": "Bundle Section Title",
          "default": "BUNDLE & SAVE"
        }
      ]
    },
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Bundle Product"
        },
        {
          "type": "text",
          "id": "bundle_title",
          "label": "Bundle Section Title",
          "default": "BUNDLE & SAVE"
        }
      ]
    },
    {
      "type": "dynamic_checkout",
      "name": "Dynamic Checkout",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show Dynamic Checkout Button",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Detail",
      "blocks": [
        { "type": "text" },
        { "type": "title" },
        { "type": "description" },
        { "type": "price" },
        { "type": "rating" },
        { "type": "promotion" },
        { "type": "variant_picker" },
        { "type": "quantity_selector" },
        { "type": "buy_buttons" },
        { "type": "dynamic_checkout" }
      ]
    }
  ]
}
{% endschema %}